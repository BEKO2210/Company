# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  The Company — root environment template                                 ║
# ║                                                                          ║
# ║  Copy this file to .env and fill in the values marked [FILL IN].          ║
# ║  Everything else has a working default for a local setup.                 ║
# ║                                                                          ║
# ║  Then run:  ./setup.sh                                                    ║
# ║  setup.sh reads this .env, generates the per-service env files, starts     ║
# ║  the database and boots the whole company.                                ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ─── Core ───────────────────────────────────────────────────────────────────
ENV_MODE=local
INTERNAL_KORTIX_ENV=dev
NEXT_PUBLIC_URL=http://localhost:3000

# ─── Database + Supabase ────────────────────────────────────────────────────
# Defaults below match the local Supabase stack that `supabase start` spins up.
# Leave them as-is for a local setup. For a hosted Supabase project, replace
# all four with the values from your Supabase dashboard.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Security secrets ───────────────────────────────────────────────────────
# Leave these EMPTY — setup.sh generates strong random values automatically
# on first run and writes them back into your .env.
API_KEY_SECRET=
TUNNEL_SIGNING_SECRET=
CRON_TICK_SECRET=
INTERNAL_SERVICE_KEY=
CHANNELS_CREDENTIAL_KEY=

# ─── Sandbox (where the agents actually run) ────────────────────────────────
ALLOWED_SANDBOX_PROVIDERS=local_docker
DOCKER_HOST=unix:///var/run/docker.sock
SANDBOX_CONTAINER_NAME=kortix-sandbox

# ─── Scheduler ──────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=true

# ─── LLM provider — [FILL IN] ───────────────────────────────────────────────
# The agents need a model to think with. Provide ONE of these.
# Get a key:  Anthropic → https://console.anthropic.com
#             OpenAI    → https://platform.openai.com
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Billing (off for self-hosted) ──────────────────────────────────────────
NEXT_PUBLIC_BILLING_ENABLED=false
KORTIX_BILLING_INTERNAL_ENABLED=false
